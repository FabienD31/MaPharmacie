{
  "expo": {
    "name": "Ma Pharmacie",
    "slug": "ma-pharmacie",
    "scheme": "mapharmacie",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fabien.mapharmacie"
    },
    "android": {
      "package": "com.fabien.mapharmacie",
      "adaptiveIcon": {
        "backgroundColor": "#1B6B9A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "L'accès à l'appareil photo sert uniquement à lire le code-barres d'une boîte de médicament. Aucune photo n'est enregistrée.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B6B9A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'accès à la photothèque sert uniquement à associer une photo à un médicament de ton inventaire.",
          "cameraPermission": "L'appareil photo sert uniquement à photographier une boîte de médicament. Les photos restent sur le téléphone."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da64de9c-b864-49c8-a27d-fe8d75f52da4"
      }
    },
    "owner": "fabiend31",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/da64de9c-b864-49c8-a27d-fe8d75f52da4"
    }
  }
}
